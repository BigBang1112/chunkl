{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ChunkL extension",
      "type": "process",
      "command": "node",
      "args": ["node_modules/typescript/bin/tsc", "-p", "./"],
      "options": {
        "cwd": "${workspaceFolder}/vscode-chunkl"
      },
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Launch ChunkL extension host",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/launchExtensionHost.js",
        "${execPath}",
        "${workspaceFolder}/vscode-chunkl",
        "${workspaceFolder}/vscode-chunkl/examples",
        "9333"
      ],
      "dependsOn": "Build ChunkL extension",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
